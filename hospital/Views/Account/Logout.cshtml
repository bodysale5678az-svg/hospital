@{
    ViewData["Title"] = "تسجيل الخروج";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4 text-center">
                <h2 class="h4 mb-3">تسجيل الخروج</h2>
                <p class="text-muted mb-4">هل أنت متأكد إنك عايز تسجل خروج من النظام؟</p>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger">أيوه، سجّل خروج</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                </form>
            </div>
        </div>
    </div>
</div>
