@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h4 mb-1 text-center">إنشاء حساب جديد</h2>
                <p class="text-muted text-center mb-4">أدخل بياناتك لإنشاء حساب</p>

                @if (ViewBag.error != null)
                {
                    <div class="alert alert-danger py-2" role="alert">@ViewBag.error</div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">الاسم الكامل</label>
                        <input id="fullName" name="fullName" class="form-control" placeholder="مثال: محمود أحمد" required />
                    </div>

                    <div class="mb-3">
                        <label for="address" class="form-label">العنوان</label>
                        <input id="address" name="address" class="form-control" placeholder="مثال: القاهرة، مدينة نصر" />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">البريد الإلكتروني</label>
                        <input id="email" name="email" type="email" class="form-control" placeholder="example@mail.com" required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">كلمة المرور</label>
                        <input id="password" name="password" type="password" class="form-control" required minlength="6" />
                        <div class="form-text">6 أحرف على الأقل</div>
                    </div>

                    <div class="mb-4">
                        <label for="roleName" class="form-label">نوع الحساب</label>
                        <select id="roleName" name="roleName" class="form-select">
                            <option value="Admin">مدير</option>
                            <option value="Doctor">طبيب</option>
                            <option value="Patient" selected>مريض</option>
                        </select>
                        <div class="form-text">أول حساب في النظام بيتعمل مدير تلقائياً.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-person-plus ms-1"></i> إنشاء الحساب
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-0 small">
                    عندك حساب بالفعل؟
                    <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                </p>
            </div>
        </div>
    </div>
</div>
