@{
    ViewData["Title"] = "إنشاء حساب مدير";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-4 border-danger">
            <div class="card-body p-4">
                <h2 class="h5 mb-1 text-center text-danger">
                    <i class="bi bi-shield-lock ms-1"></i> إنشاء حساب مدير
                </h2>
                <p class="text-muted text-center mb-4 small">
                    هذه الصفحة مخصصة للإيميلات المصرّح لها فقط.
                </p>

                @if (ViewBag.error != null)
                {
                    <div class="alert alert-danger py-2" role="alert">@ViewBag.error</div>
                }

                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-exclamation-triangle ms-1"></i>
                    البريد الإلكتروني لازم يكون مكتوب مسبقاً في
                    <code>AdminSettings:AdminEmails</code>.
                </div>

                <form asp-controller="Account" asp-action="RegisterAdmin" method="post">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">الاسم الكامل</label>
                        <input id="fullName" name="fullName" class="form-control" placeholder="مثال: محمود أحمد" required />
                    </div>

                    <div class="mb-3">
                        <label for="address" class="form-label">العنوان</label>
                        <input id="address" name="address" class="form-control" placeholder="مثال: القاهرة، مدينة نصر" />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">البريد الإلكتروني</label>
                        <input id="email" name="email" type="email" class="form-control" placeholder="admin@example.com" required />
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">كلمة المرور</label>
                        <input id="password" name="password" type="password" class="form-control" required minlength="6" autocomplete="new-password" />
                        <div class="form-text">6 أحرف على الأقل</div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-shield-check ms-1"></i> إنشاء حساب المدير
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-0 small">
                    عندك حساب عادي؟
                    <a asp-controller="Account" asp-action="Register">تسجيل حساب طبيب أو مريض</a>
                </p>
            </div>
        </div>
    </div>
</div>
