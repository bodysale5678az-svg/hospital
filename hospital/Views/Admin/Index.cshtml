@model List<hospital.Controllers.AdminController.UserRow>
@{
    ViewData["Title"] = "لوحة المدير";
    var doctorList = ViewBag.DoctorList as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var patientList = ViewBag.PatientList as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<h2 class="h4 mb-4"><i class="bi bi-shield-check text-danger ms-1"></i> لوحة تحكم المدير</h2>

<div class="mb-3">
    <a asp-action="Passwords" class="btn btn-outline-primary">
        <i class="bi bi-key-fill"></i> إدارة كلمات المرور
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0"><div class="card-body">
            <div class="h3 mb-1">@ViewBag.TotalUsers</div><div class="text-muted small">إجمالي المستخدمين</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0"><div class="card-body">
            <div class="h3 mb-1 text-danger">@ViewBag.Admins</div><div class="text-muted small">مديرين</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0"><div class="card-body">
            <div class="h3 mb-1 text-primary">@ViewBag.Doctors</div><div class="text-muted small">أطباء</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0"><div class="card-body">
            <div class="h3 mb-1 text-success">@ViewBag.Patients</div><div class="text-muted small">مرضى</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">إدارة المستخدمين والصلاحيات والربط</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>البريد</th>
                    <th>الصلاحية</th>
                    <th>مربوط بـ</th>
                    <th class="text-center">تغيير الصلاحية</th>
                    <th class="text-center">الربط</th>
                    <th class="text-center">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td class="text-truncate" style="max-width: 200px;">@u.Email</td>
                        <td>
                            @if (u.Role == RoleNames.Admin)
                            {
                                <span class="badge bg-danger">مدير</span>
                            }
                            else if (u.Role == RoleNames.Doctor)
                            {
                                <span class="badge bg-primary">طبيب</span>
                            }
                            else if (u.Role == RoleNames.Patient)
                            {
                                <span class="badge bg-success">مريض</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">بدون</span>
                            }
                        </td>
                        <td>
                            @if (u.DoctorId.HasValue)
                            {
                                <span class="text-primary"><i class="bi bi-person-badge"></i> @u.DoctorName <span class="text-muted small">(#@u.DoctorId)</span></span>
                            }
                            else if (u.PatientId.HasValue)
                            {
                                <span class="text-success"><i class="bi bi-person-heart"></i> @u.PatientName <span class="text-muted small">(#@u.PatientId)</span></span>
                            }
                            else
                            {
                                <span class="text-muted small">غير مربوط</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="SetRole" method="post" class="d-flex gap-1 justify-content-center">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="role" class="form-select form-select-sm" style="width: 110px;">
                                    <option value="Patient" selected="@(u.Role == RoleNames.Patient)">مريض</option>
                                    <option value="Doctor" selected="@(u.Role == RoleNames.Doctor)">طبيب</option>
                                    <option value="Admin" selected="@(u.Role == RoleNames.Admin)">مدير</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">حفظ</button>
                            </form>
                        </td>
                        <td>
                            @if (u.Role == RoleNames.Doctor)
                            {
                                <form asp-controller="Admin" asp-action="LinkDoctor" method="post" class="d-flex gap-1 justify-content-center">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <select name="doctorId" class="form-select form-select-sm" style="width: 170px;">
                                        <option value="">— بدون ربط —</option>
                                        @foreach (var item in doctorList!)
                                        {
                                            <option value="@item.Value" selected="@(u.DoctorId?.ToString() == item.Value)">@item.Text</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-success">ربط</button>
                                </form>
                            }
                            else if (u.Role == RoleNames.Patient)
                            {
                                <form asp-controller="Admin" asp-action="LinkPatient" method="post" class="d-flex gap-1 justify-content-center">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <select name="patientId" class="form-select form-select-sm" style="width: 170px;">
                                        <option value="">— بدون ربط —</option>
                                        @foreach (var item in patientList!)
                                        {
                                            <option value="@item.Value" selected="@(u.PatientId?.ToString() == item.Value)">@item.Text</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-success">ربط</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <form asp-controller="Admin" asp-action="DeleteUser" method="post"
                                  onsubmit="return confirm('متأكد إنك عايز تمسح المستخدم ده؟');">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
