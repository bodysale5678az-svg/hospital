@model List<hospital.Controllers.AdminController.PasswordRow>
@{
    ViewData["Title"] = "إدارة كلمات المرور";
}

<div class="page-hero page-hero--compact mb-4">
    <div class="page-hero__content">
        <div class="page-hero__text">
            <span class="page-hero__badge">
                <i class="bi bi-key-fill"></i> إدارة الحسابات
            </span>
            <h2 class="page-hero__title">إدارة كلمات المرور</h2>
            <p class="page-hero__desc">حدّد كلمة مرور جديدة لأي مستخدم، أو افك قفل حساب.</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle ms-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle ms-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-info d-flex align-items-start gap-2">
    <i class="bi bi-shield-lock"></i>
    <div class="small">
        كلمات المرور <strong>متشفّرة</strong> في قاعدة البيانات — مفيش طريقة لقراءتها.
        المدير هنا يقدر <strong>يحدّد</strong> كلمة مرور جديدة بس، مش يعرض القديمة.
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        المستخدمون (@Model.Count)
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>البريد</th>
                    <th>الاسم</th>
                    <th>الصلاحية</th>
                    <th>الحالة</th>
                    <th style="min-width:280px;">كلمة مرور جديدة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="text-truncate" style="max-width:220px;" title="@u.Email">@u.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</td>
                        <td>
                            @switch (u.Role)
                            {
                                case "Admin":
                                    <span class="badge bg-danger">مدير</span>
                                    break;
                                case "Doctor":
                                    <span class="badge bg-primary">طبيب</span>
                                    break;
                                case "Patient":
                                    <span class="badge bg-success">مريض</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">بدون دور</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (u.HasLockout)
                            {
                                <span class="badge bg-warning text-dark">مقفول</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">نشط</span>
                            }
                        </td>
                        <td>
                            <form asp-action="SetPassword" method="post" class="d-flex gap-2 align-items-start"
                                  onsubmit="return confirm('متأكد إنك عايز تغيّر كلمة مرور @u.Email؟');">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <div>
                                    <input type="password" name="newPassword" class="form-control form-control-sm"
                                           placeholder="كلمة المرور" required minlength="6" autocomplete="new-password" />
                                </div>
                                <div>
                                    <input type="password" name="confirmPassword" class="form-control form-control-sm"
                                           placeholder="تأكيد" required minlength="6" autocomplete="new-password" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                    <i class="bi bi-key"></i> تغيير
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            @if (u.HasLockout)
                            {
                                <form asp-action="UnlockUser" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning text-nowrap">
                                        <i class="bi bi-unlock"></i> فك القفل
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> رجوع للوحة المدير
    </a>
</div>
