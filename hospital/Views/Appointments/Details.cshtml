@model hospital.Models.Appointment

@{
    ViewData["Title"] = "تفاصيل الحجز";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="page-title mb-1">تفاصيل الحجز</h2>
        <p class="page-subtitle mb-0">@(Model.Patient?.Name ?? "—") — @(Model.Doctor?.Name ?? "—")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع للقائمة</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3">المريض</dt>
                    <dd class="col-sm-9 fw-bold">@(Model.Patient?.Name ?? "—")</dd>

                    <dt class="col-sm-3">الطبيب</dt>
                    <dd class="col-sm-9">@(Model.Doctor?.Name ?? "—")</dd>

                    <dt class="col-sm-3">الموعد</dt>
                    <dd class="col-sm-9" dir="ltr">@Model.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-3">الحالة</dt>
                    <dd class="col-sm-9"><span class="badge text-bg-info">@Model.Status</span></dd>

                    <dt class="col-sm-3">ملاحظات</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>

                    <dt class="col-sm-3">التشخيص</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Diagnosis) ? "—" : Model.Diagnosis)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
