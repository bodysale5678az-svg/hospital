@model hospital.Models.Doctor

@{
    ViewData["Title"] = "تفاصيل الطبيب";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="page-title mb-1">@Model.Name</h2>
        <p class="page-subtitle mb-0">@(Model.Specialization?.Name ?? "بدون تخصص")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع للقائمة</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="~/@Model.ImageUrl" alt="@Model.Name" class="doctor-img"
                             style="width:64px;height:64px;" onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <span class="doctor-avatar" style="width:64px;height:64px;font-size:1.3rem;">
                            @(string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim().Substring(0, 1))
                        </span>
                    }
                    <div>
                        <h5 class="mb-1 fw-bold">@Model.Name</h5>
                        <span class="text-muted small">@(Model.Specialization?.Name ?? "—")</span>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-5">اسم الطبيب</dt>
                    <dd class="col-sm-7 fw-bold">@Model.Name</dd>

                    <dt class="col-sm-5">Specialization</dt>
                    <dd class="col-sm-7">@(Model.Specialization?.Name ?? "—")</dd>

                    <dt class="col-sm-5">رقم الهاتف</dt>
                    <dd class="col-sm-7" dir="ltr">@Model.Phone</dd>

                    <dt class="col-sm-5">سعر الكشف</dt>
                    <dd class="col-sm-7">@Model.ConsultationFee.ToString("N0") ر.س</dd>

                    <dt class="col-sm-5">عدد الحجوزات</dt>
                    <dd class="col-sm-7">@Model.Appointments.Count</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-calendar-check ms-1"></i> حجوزات الطبيب
            </div>
            <div class="card-body p-0">
                @if (!Model.Appointments.Any())
                {
                    <div class="empty-state border-0">
                        <i class="bi bi-calendar-x"></i>
                        <h5 class="small">لا توجد حجوزات</h5>
                        <p class="text-muted mb-0 small">لا توجد مواعيد محجوزة لهذا الطبيب.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>المريض</th>
                                    <th>الموعد</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                                {
                                    <tr>
                                        <td>@(appt.Patient?.Name ?? "—")</td>
                                        <td class="text-muted" dir="ltr">@appt.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge text-bg-info">@appt.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
