@model List<hospital.Models.Appointment>
@{
    ViewData["Title"] = "لوحة الطبيب";
    var me = ViewBag.Me as hospital.Models.ApplicationUser;
    var doc = ViewBag.Doctor as hospital.Models.Doctor;
    bool notLinked = ViewBag.NotLinked == true;
}

<h2 class="h4 mb-4"><i class="bi bi-person-badge text-primary ms-1"></i> لوحة تحكم الطبيب</h2>

@if (notLinked)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle ms-1"></i>
        حسابك مش مربوط بملف طبيب. اطلب من المدير يربط حسابك من لوحة المدير.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-semibold">بياناتي</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">الصلاحية</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">طبيب</span></dd>

                        <dt class="col-sm-4">الاسم</dt>
                        <dd class="col-sm-8">@(doc?.Name ?? me?.FullName)</dd>

                        <dt class="col-sm-4">التخصص</dt>
                        <dd class="col-sm-8">@(doc?.Specialization?.Name ?? "-")</dd>

                        <dt class="col-sm-4">الهاتف</dt>
                        <dd class="col-sm-8">@(doc?.Phone ?? "-")</dd>

                        <dt class="col-sm-4">سعر الكشف</dt>
                        <dd class="col-sm-8">@(doc != null ? doc.ConsultationFee.ToString("0.00") + " ج" : "-")</dd>

                        <dt class="col-sm-4">البريد</dt>
                        <dd class="col-sm-8 mb-0">@(me?.Email ?? "-")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="display-4 text-primary">@Model.Count</div>
                    <div class="text-muted">موعد مسجل باسمي</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">مواعيدي</div>
        @if (Model.Count == 0)
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                مفيش مواعيد مسجلة باسمك حالياً.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>المريض</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.Patient?.Name</td>
                                <td>@a.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-info text-dark">@a.Status</span></td>
                                <td class="text-end">
                                    <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-primary">تفاصيل</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
