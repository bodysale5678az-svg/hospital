@model hospital.Models.Patient

@{
    ViewData["Title"] = "تفاصيل المريض";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="page-title mb-1">@Model.Name</h2>
        <p class="page-subtitle mb-0">بيانات المريض وسجل الحجوزات</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع للقائمة</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="doctor-avatar" style="width:64px;height:64px;font-size:1.3rem;">
                        @(string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim().Substring(0, 1))
                    </span>
                    <div>
                        <h5 class="mb-1 fw-bold">@Model.Name</h5>
                        <span class="text-muted small">@Model.Gender — @Model.Age سنة</span>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">اسم المريض</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                    <dt class="col-sm-4">رقم الهاتف</dt>
                    <dd class="col-sm-8" dir="ltr">@Model.Phone</dd>

                    <dt class="col-sm-4">السن</dt>
                    <dd class="col-sm-8">@Model.Age سنة</dd>

                    <dt class="col-sm-4">النوع</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Gender) ? "—" : Model.Gender)</dd>

                    <dt class="col-sm-4">عدد الحجوزات</dt>
                    <dd class="col-sm-8">@Model.Appointments.Count</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-calendar-check ms-1"></i> حجوزات المريض
            </div>
            <div class="card-body p-0">
                @if (!Model.Appointments.Any())
                {
                    <div class="empty-state border-0">
                        <i class="bi bi-calendar-x"></i>
                        <h5 class="small">لا توجد حجوزات</h5>
                        <p class="text-muted mb-0 small">لم يقم هذا المريض بأي حجز بعد.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>الطبيب</th>
                                    <th>الموعد</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                                {
                                    <tr>
                                        <td>@(appt.Doctor?.Name ?? "—")</td>
                                        <td class="text-muted" dir="ltr">@appt.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge text-bg-info">@appt.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
