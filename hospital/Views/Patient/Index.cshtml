@model IEnumerable<hospital.Models.Patient>

@{
    ViewData["Title"] = "سجل المرضى";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="page-title mb-1">سجل المرضى</h2>
        <p class="page-subtitle mb-0">جميع المرضى المسجلين في عيادات آل صالح التخصصي</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> إضافة مريض
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMsg</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@errorMsg</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="spec-toolbar mb-4">
    <div class="input-group spec-search">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" id="patientSearch" class="form-control border-start-0 ps-0"
               placeholder="ابحث بالاسم أو رقم الهاتف..." autocomplete="off" />
    </div>
    <span class="text-muted small" id="patientCount">
        إجمالي <strong>@Model.Count()</strong> مريض
    </span>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h5>لا يوجد مرضى مسجلين</h5>
        <p class="text-muted mb-0">ابدأ بإضافة أول مريض في النظام.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>اسم المريض</th>
                            <th>رقم الهاتف</th>
                            <th>السن</th>
                            <th>النوع</th>
                            <th>الحجوزات</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="patientRows">
                        @foreach (var item in Model)
                        {
                            <tr data-search="@item.Name @item.Phone">
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-muted" dir="ltr">@item.Phone</td>
                                <td class="text-muted">@item.Age سنة</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Gender) ? "—" : item.Gender)</td>
                                <td>
                                    <span class="badge text-bg-light">@item.Appointments.Count</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" title="تفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action--danger" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="empty-state d-none" id="patientEmpty">
        <i class="bi bi-search"></i>
        <h5>لا توجد نتائج مطابقة</h5>
        <p class="text-muted mb-0">جرّب البحث باسم أو رقم آخر.</p>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('patientSearch');
            if (!input) return;
            var rows = document.querySelectorAll('#patientRows tr');
            var empty = document.getElementById('patientEmpty');
            var count = document.getElementById('patientCount');

            input.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                var shown = 0;

                rows.forEach(function (row) {
                    var match = row.dataset.search.toLowerCase().indexOf(q) !== -1;
                    row.classList.toggle('d-none', !match);
                    if (match) shown++;
                });

                if (empty) empty.classList.toggle('d-none', shown !== 0);
                if (count) count.innerHTML = 'نتائج البحث: <strong>' + shown + '</strong> مريض';
            });
        })();
    </script>
}
