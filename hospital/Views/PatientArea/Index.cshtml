@model List<hospital.Models.Appointment>
@{
    ViewData["Title"] = "لوحة المريض";
    var me = ViewBag.Me as hospital.Models.ApplicationUser;
    var pat = ViewBag.Patient as hospital.Models.Patient;
    bool notLinked = ViewBag.NotLinked == true;
}

<h2 class="h4 mb-4"><i class="bi bi-person-heart text-success ms-1"></i> لوحة تحكم المريض</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle ms-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle ms-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (notLinked)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle ms-1"></i>
        جاري تجهيز ملفك... لو الرسالة دي فضلت ظاهرة حدّث الصفحة.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span>بياناتي</span>
                    <a asp-action="EditProfile" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-pencil"></i> تعديل
                    </a>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">الصلاحية</dt>
                        <dd class="col-sm-8"><span class="badge bg-success">مريض</span></dd>

                        <dt class="col-sm-4">الاسم</dt>
                        <dd class="col-sm-8">@(pat?.Name ?? me?.FullName)</dd>

                        <dt class="col-sm-4">الهاتف</dt>
                        <dd class="col-sm-8">@(pat?.Phone ?? "-")</dd>

                        <dt class="col-sm-4">السن</dt>
                        <dd class="col-sm-8">@(pat != null ? pat.Age.ToString() : "-")</dd>

                        <dt class="col-sm-4">البريد</dt>
                        <dd class="col-sm-8 mb-0">@(me?.Email ?? "-")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <i class="bi bi-calendar-plus display-5 text-success mb-2"></i>
                    <p class="text-muted mb-2">حابب تحجز كشف جديد؟</p>
                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-success">حجز موعد</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">مواعيدي</div>
        @if (Model.Count == 0)
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                مفيش مواعيد مسجلة لحد الآن.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الطبيب</th>
                            <th>التخصص</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.Doctor?.Name</td>
                                <td>@a.Doctor?.Specialization?.Name</td>
                                <td>@a.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-info text-dark">@a.Status</span></td>
                                <td class="text-end">
                                    @if (a.Status != "ملغي" && a.Status != "مكتمل")
                                    {
                                        <form asp-action="CancelAppointment" asp-route-id="@a.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('متأكد إنك عايز تلغي الموعد؟');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle"></i> إلغاء
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
