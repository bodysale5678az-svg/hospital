@model hospital.Models.Specialization

@{
    ViewData["Title"] = "تعديل التخصص";
}

<div class="page-hero page-hero--compact mb-4">
    <div class="page-hero__content">
        <div class="page-hero__text">
            <span class="page-hero__badge">
                <i class="bi bi-pencil-fill"></i> تعديل
            </span>
            <h2 class="page-hero__title">تعديل: @Model.Name</h2>
            <p class="page-hero__desc">عدّل بيانات التخصص ثم اضغط حفظ لتطبيق التغييرات.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-empty"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2"></i> حفظ التغييرات
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
